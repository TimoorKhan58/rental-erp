{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "rentcore-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "-p",
        "3000"
      ],
      "env": {
        "APP_URL": "http://localhost:3000",
        "BETTER_AUTH_URL": "http://localhost:3000",
        "NEXT_PUBLIC_APP_URL": "http://localhost:3000"
      },
      "port": 3000,
      "autoPort": false
    },
    {
      "name": "rentcore-app",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "start",
        "--",
        "-p",
        "3000"
      ],
      "env": {
        "APP_URL": "http://localhost:3000",
        "BETTER_AUTH_URL": "http://localhost:3000",
        "NEXT_PUBLIC_APP_URL": "http://localhost:3000"
      },
      "port": 3000,
      "autoPort": false
    }
  ]
}
